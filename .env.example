# Copie para .env e preencha.
PORT=3000
NODE_ENV=production

# Endereço público do site (HTTPS). Necessário para o Mercado Pago avisar quando o Pix for pago.
BASE_URL=https://seu-dominio.com.br

# Login inicial do painel (/admin). Usado só na primeira vez que o site sobe — depois troque a senha no painel.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Pasta onde ficam o banco de dados e as fotos enviadas (precisa ser um disco persistente).
# DATA_DIR=/app/data

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Sem estas chaves, o site funciona em MODO DEMONSTRAÇÃO (pagamentos simulados).
# Use as credenciais de TESTE (TEST-...) primeiro, depois troque pelas de produção (APP_USR-...).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Assinatura secreta dos webhooks (Suas integrações > Webhooks > Assinatura secreta)
MP_WEBHOOK_SECRET=
